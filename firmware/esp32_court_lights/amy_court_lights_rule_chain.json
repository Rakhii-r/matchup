      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Court event to setState",
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "// TEST uses the dashboard's FOUR command. The controller has no dedicated test command.\nvar states = { FOUR: '4', SIX: '6', WICKET: 'out', TEST: '4' };\nvar deadline = Math.min(msg.expires_at * 1000, Date.now() + 5000);\nmetadata.expirationTime = String(deadline);\nmetadata.requestUUID = msg.event_id;\nmetadata.persistent = 'false';\nmetadata.retries = '0';\nreturn {\n    msg: { method: 'setState', params: states[msg.event] },\n    metadata: metadata,\n    msgType: 'RPC_CALL_FROM_SERVER_TO_DEVICE'\n};"
