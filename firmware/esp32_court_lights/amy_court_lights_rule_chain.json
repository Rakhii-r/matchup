      {
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "Fresh AMY court light event",
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "if (msgType !== 'POST_TELEMETRY_REQUEST' || metadata.deviceName !== 'AMY box court') {\n    return false;\n}\nvar knownEvent = msg.event === 'FOUR' || msg.event === 'SIX' ||\n    msg.event === 'WICKET' || msg.event === 'TEST';\nvar uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nvar remainingMs = msg.expires_at * 1000 - Date.now();\nreturn knownEvent && typeof msg.event_id === 'string' && uuid.test(msg.event_id) &&\n    typeof msg.expires_at === 'number' && remainingMs > 0 && remainingMs <= 10000;"
        },
        "additionalInfo": {
          "layoutX": 1280,
          "layoutY": 271
        }
