# Copy to .env and fill in real values. NEVER commit real values.
# EXPO_PUBLIC_* vars are embedded in the client bundle, so only public keys belong here.

EXPO_PUBLIC_APP_ENV=development

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Analytics / crash reporting
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# Demo mode. 'true' seeds the nearby feed with 6 fake matches so a client demo
# never opens on an empty screen. They are non-interactive and cannot be joined.
# Leave 'false' for anything a real user will touch; forced off in production.
EXPO_PUBLIC_DEMO_MATCHES=false
